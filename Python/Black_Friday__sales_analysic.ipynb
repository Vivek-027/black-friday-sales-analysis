      }
    },
    {
      "cell_type": "markdown",
      "source": [
        " 5. Which city category (A/B/C) generates the most revenue?"
      ],
      "metadata": {
        "id": "pBKcSZReNTk5"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "city_summary = data.groupby('City_Category')['Purchase'].agg(['mean', 'sum', 'count'])\n",
        "city_summary\n",
        "\n",
        "plt.figure(figsize=(6, 4))\n",
        "sns.barplot(x=city_summary.index, y=city_summary['sum'])\n",
        "plt.title('Total Revenue by City Category')\n",
        "plt.xlabel('City Category')\n",
        "plt.ylabel('Total Purchase')\n",
        "plt.show()"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 443
        },
        "id": "9tjTWOT9HkNA",
